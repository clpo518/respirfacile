# ============================================
# SUPABASE
# ============================================
# Récupérer dans https://supabase.com
# Settings > API > Project URL & anon key

NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# STRIPE
# ============================================
# Récupérer dans https://dashboard.stripe.com
# Settings > Keys and credentials
# + Webhooks pour signing secret

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_abc123...
STRIPE_SECRET_KEY=sk_test_xyz789...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs créés pour les 3 plans
STRIPE_PRICE_STARTER=price_1234567890
STRIPE_PRICE_PRO=price_0987654321
STRIPE_PRICE_CABINET=price_1111111111

# ============================================
# APP
# ============================================
# Domaine réellement servi. Alimente les canonical, le sitemap et les JSON-LD
# via lib/site.ts. En local : http://localhost:3000.
# Sur Vercel : laisser vide tant que respirfacile.fr n'est pas branché, le
# domaine de production Vercel est repris automatiquement. Ne jamais pointer
# vers un domaine qui ne résout pas, Google ignorerait toutes les pages.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================
# EMAIL (OPTIONNEL - Resend)
# ============================================
# Pour emails transactionnels (confirmations, notifications)
# https://resend.com

RESEND_API_KEY=re_...

# ============================================
# RATE LIMITING (OPTIONNEL)
# ============================================
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
